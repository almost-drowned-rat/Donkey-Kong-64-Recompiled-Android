+    void config::add_option_button(const std::string &option_id, const std::string &label, std::function<void()> callback) {
+        option_buttons[option_id].push_back(config::OptionButton{ label, std::move(callback) });
+    }
+
+    const std::vector<config::OptionButton> *config::get_option_buttons(const std::string &option_id) {
+        auto it = option_buttons.find(option_id);
+        return it != option_buttons.end() ? &it->second : nullptr;
+    }
